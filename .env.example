DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
SESSION_SECRET="change-me-to-a-long-random-string"

# Habilita geocoding + tiempos de viaje reales (Geocoding API + Distance Matrix API).
# Sin esta key, la app usa Nominatim (geocoding gratuito) y una aproximación por
# distancia en línea recta para el tiempo de viaje.
GOOGLE_MAPS_API_KEY=""

# Misma llave (o una restringida por dominio), expuesta al navegador para el
# autocompletado de direcciones. Requiere habilitar "Places API" en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
